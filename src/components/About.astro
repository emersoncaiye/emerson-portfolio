---
import type { Content } from '../content/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="about" class="section container" aria-labelledby="about-label">
  <div class="section-head reveal">
    <span class="section-index">05</span>
    <h2 class="section-kicker" id="about-label">{t.about.label}</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>

  <div class="about-grid">
    <div class="about-left reveal">
      <h3 class="about-heading">{t.about.heading}</h3>
      <figure class="about-photo">
        <div class="img-frame" style="aspect-ratio: 3 / 4;">
          <img src={t.about.image} alt={t.about.imageAlt} loading="lazy" width="1200" height="1600" />
        </div>
        <figcaption>{t.about.imageCaption}</figcaption>
      </figure>
    </div>

    <div class="about-right reveal reveal-delay-1">
      <div class="about-paras prose">
        {t.about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <p class="about-traits">
        {t.about.traits.map((trait) => (
          <span>{trait}</span>
        ))}
      </p>
    </div>
  </div>

  <div class="beyond reveal">
    <div class="beyond-head">
      <span class="beyond-label">{t.about.beyondLabel}</span>
      <p class="beyond-intro">{t.about.beyondIntro}</p>
    </div>
    <ul class="beyond-grid">
      {t.about.beyond.map((item) => (
        <li class="beyond-item">
          <h4 class="beyond-title">{item.title}</h4>
          <p class="beyond-text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section {
    padding-top: 5.25rem;
    padding-bottom: 3.5rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    column-gap: 4.5rem;
    align-items: start;
  }

  .about-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
    max-width: 16ch;
    margin-bottom: 2.25rem;
  }

  .about-photo {
    max-width: 320px;
  }

  .about-paras {
    padding-top: 0.25rem;
  }

  .about-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .about-traits span {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* ===== Beyond Work ===== */
  .beyond {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 2.25rem;
  }

  .beyond-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .beyond-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .beyond-intro {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .beyond-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .beyond-item {
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }

  .beyond-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .beyond-text {
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--text-soft);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }

    .beyond-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .section {
      padding-top: 4.5rem;
    }

    .beyond-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .about-photo {
      max-width: 260px;
    }
  }
</style>
