---
import type { Content } from '../content/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="hero container" id="introduction" aria-label="Introduction">
  <p class="hero-label reveal"><span class="hero-index">01</span>{t.hero.label}</p>
  <h1 class="hero-headline reveal reveal-delay-1">{t.hero.headline}</h1>
  <p class="hero-sub reveal reveal-delay-2">{t.hero.sub}</p>

  <div class="hero-footer reveal reveal-delay-3">
    <div class="hero-identity">
      <span class="hero-name">{t.hero.name}</span>
      <span class="hero-name-meta">{t.hero.nameMeta}</span>
    </div>
    <ul class="hero-meta" aria-label="Focus">
      {t.hero.meta.map((m) => (
        <li>{m}</li>
      ))}
    </ul>
    <a class="hero-scroll" href="#work" aria-label={t.hero.scroll}>
      <span class="scroll-label">{t.hero.scroll}</span>
      <span class="scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    padding-top: 9.5rem;
    padding-bottom: 4.5rem;
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero-index {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.75rem;
  }

  .hero-label {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8.5vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.02;
    color: var(--text);
    max-width: 12ch;
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-soft);
    max-width: 34ch;
    margin-top: 2.25rem;
  }

  .hero-footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-identity {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .hero-name-meta {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hero-meta {
    list-style: none;
    display: flex;
    gap: 0;
    flex-wrap: wrap;
  }

  .hero-meta li {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 0 1.25rem;
    border-left: 1px solid var(--border);
    line-height: 1.4;
  }

  .hero-meta li:first-child {
    padding-left: 0;
    border-left: none;
  }

  .hero-scroll {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .scroll-label {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 44px;
    background: var(--border-strong);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -100%;
    width: 100%;
    height: 50%;
    background: var(--accent);
    animation: drip 2.6s var(--ease) infinite;
  }

  @keyframes drip {
    0% { top: -50%; }
    100% { top: 110%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 7.5rem;
      padding-bottom: 3rem;
      min-height: 72vh;
    }

    .hero-meta {
      flex-direction: column;
      gap: 0.4rem;
    }

    .hero-meta li {
      padding: 0;
      border-left: none;
    }

    .hero-footer {
      margin-top: 3.5rem;
    }

    .hero-scroll {
      align-items: flex-start;
    }
  }
</style>
