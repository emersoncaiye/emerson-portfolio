---
import type { Content, Lang } from '../content/types';
import type { Article } from '../content/types';
import { base, langLinks } from '../content';
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  t: Content;
  article: Article;
}

const { lang, t, article } = Astro.props;
const backHref = `${base(lang)}/#journal`;
---

<Layout lang={lang} title={`${article.title} — ${t.journal.label}`} description={article.intro} skipLabel={t.a11y.skip}>
  <Nav lang={lang} t={t} langLinks={langLinks(lang, `/journal/${article.slug}/`)} />

  <main id="main" class="article">
    <header class="article-head container">
      <a class="back-link" href={backHref}>
        <span aria-hidden="true">←</span> {t.journal.labels.back}
      </a>
      <h1 class="article-title">{article.title}</h1>
      <div class="article-meta">
        <span class="meta-place">{article.place}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-detail">{article.meta}</span>
      </div>
    </header>

    {article.image && (
      <figure class="article-hero container reveal">
        <div class="img-frame" style="aspect-ratio: 16 / 9;">
          <img src={article.image} alt={article.imageAlt} width="1200" height="1600" />
        </div>
      </figure>
    )}

    <div class="article-body container">
      <p class="article-intro reveal">{article.intro}</p>
      <div class="prose reveal">
        {article.body.map((item) =>
          typeof item === 'string' ? (
            <p>{item}</p>
          ) : (
            <figure class="inline-figure">
              <div class="img-frame" style="aspect-ratio: 3 / 2;">
                <img src={item.image} alt={item.alt} loading="lazy" width="1600" height="1200" />
              </div>
              <figcaption>{item.caption}</figcaption>
            </figure>
          )
        )}
      </div>
      <div class="article-tags">
        <span class="tags-label">{t.journal.labels.tags}</span>
        {article.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>

    <div class="container">
      <a class="back-link bottom" href={backHref}>
        <span aria-hidden="true">←</span> {t.journal.labels.all}
      </a>
    </div>
  </main>

  <Footer t={t} />
</Layout>

<style>
  .article {
    padding-top: 8rem;
  }

  .back-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    transition: color 0.3s var(--ease);
  }

  .back-link:hover {
    color: var(--text);
  }

  .article-head {
    max-width: 820px;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
    max-width: 16ch;
    margin-bottom: 1.5rem;
  }

  .article-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-place {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  .meta-sep {
    color: var(--border-strong);
  }

  .meta-detail {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .article-hero {
    margin-top: 3rem;
    margin-bottom: 3.5rem;
    max-width: 980px;
  }

  .article-body {
    max-width: 820px;
  }

  .article-intro {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--text);
    max-width: var(--measure);
    margin-bottom: 2rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .article-intro::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    bottom: 0.3rem;
    width: 2px;
    background: var(--accent);
  }

  .inline-figure {
    margin: 2.75rem 0;
  }

  .inline-figure figcaption {
    margin-top: 0.65rem;
    max-width: 52ch;
  }

  .article-tags {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .tags-label {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .tag {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    border: 1px solid var(--border);
    padding: 0.2rem 0.7rem;
  }

  .back-link.bottom {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 7rem;
    }

    .article-hero {
      margin-top: 2.25rem;
    }
  }
</style>
