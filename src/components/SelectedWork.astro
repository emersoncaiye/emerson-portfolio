---
import type { Content } from '../content/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { delta, site } = t.work;
---

<section id="work" class="section container" aria-labelledby="work-label">
  <div class="section-head reveal">
    <span class="section-index">02</span>
    <h2 class="section-kicker" id="work-label">{t.work.label}</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>
  <p class="section-standfirst reveal">{t.work.intro}</p>

  <!-- Featured project: Delta — full-width feature -->
  <article class="feature reveal">
    <a
      href={delta.link.href}
      class="feature-media img-frame"
      aria-hidden="true"
      tabindex="-1"
    >
      <img src={delta.image} alt={delta.imageAlt} loading="lazy" width="1600" height="1000" />
    </a>
    <figcaption class="feature-caption">{delta.imageCaption}</figcaption>
    <div
      class="delta-strip moments-scroll reveal"
      tabindex="0"
      role="region"
      aria-label={`${delta.title} — ${t.work.label}`}
    >
      {t.deltaCase.gallery.slice(1).map((g) => (
        <figure class="moment-card wide">
          <div class="moment-img">
            <img src={g.image} alt={g.alt} loading="lazy" width="1600" height="1000" />
          </div>
          <figcaption class="moment-caption">{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="feature-body">
      <div class="feature-left">
        <span class="feature-num">{delta.num}</span>
        <h3 class="feature-title">
          <a href={delta.link.href} class="feature-title-link">{delta.title}</a>
        </h3>
      </div>
      <div class="feature-right">
        <div class="feature-meta">
          <ul class="cat-list" aria-label="Categories">
            {delta.categories.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
          <span class="feature-year">{delta.year}</span>
        </div>
        <p class="feature-text">{delta.intro}</p>
        <a class="text-link" href={delta.link.href}>
          {delta.link.label}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>

  <!-- Project 02: image-left / text-right -->
  <article class="project-alt reveal">
    <figure class="project-alt-figure">
    <a
      href={site.link.href}
      class="project-alt-media site-visual"
      aria-hidden="true"
      tabindex="-1"
    >
      <span class="visual-desktop img-frame">
        <img src={site.image} alt={site.imageAlt} loading="lazy" width="1600" height="1000" />
      </span>
      <span class="visual-mobile img-frame">
        <img
          src={site.imageMobile ?? site.image}
          alt=""
          loading="lazy"
          width="390"
          height="780"
        />
      </span>
    </a>
    <figcaption class="project-alt-caption">{site.imageCaption}</figcaption>
    </figure>
    <div class="project-alt-body">
      <div class="project-alt-meta">
        <span class="feature-num small">{site.num}</span>
        <span class="feature-year">{site.year}</span>
      </div>
      <h3 class="project-alt-title">{site.title}</h3>
      <ul class="cat-list" aria-label="Categories">
        {site.categories.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
      <p class="project-alt-text">{site.intro}</p>
      <ul class="point-list">
        {site.points?.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
      <a
        class="text-link"
        href={site.link.href}
        target={site.link.external ? '_blank' : undefined}
        rel={site.link.external ? 'noopener' : undefined}
      >
        {site.link.label}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </article>
</section>

<style>
  .section {
    padding-top: 5.25rem;
    padding-bottom: 2.5rem;
  }

  /* ===== Feature (Delta) ===== */
  .feature-media {
    aspect-ratio: 16 / 10;
    display: block;
  }

  .feature-body {
    display: grid;
    grid-template-columns: 5fr 6fr;
    column-gap: 4rem;
    padding-top: 2.25rem;
  }

  .feature-num {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1.1rem;
  }

  .feature-num.small {
    margin-bottom: 0;
  }

  .feature-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--text);
  }

  .feature-title-link {
    transition: color 0.3s var(--ease);
  }

  .feature-title-link:hover {
    color: var(--accent);
  }

  .feature-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cat-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
  }

  .cat-list li {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .feature-year {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .feature-text {
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--text-soft);
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .feature-caption {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .delta-strip {
    margin-bottom: 1rem;
  }

  /* ===== Project 02 (smaller, alternating) ===== */
  .project-alt {
    margin-top: 5rem;
    display: grid;
    grid-template-columns: 6fr 5fr;
    column-gap: 3.5rem;
    align-items: start;
  }

  .project-alt-figure {
    margin: 0;
  }

  .project-alt-caption {
    margin-top: 0.75rem;
  }

  .project-alt-media {
    display: block;
  }

  /* Desktop + mobile views, overlapped rather than mocked up in a device frame */
  .site-visual {
    position: relative;
    padding-bottom: 7%;
  }

  .visual-desktop {
    aspect-ratio: 16 / 10;
    display: block;
    border: 1px solid var(--border);
  }

  .visual-mobile {
    position: absolute;
    right: -4%;
    bottom: 0;
    width: 28%;
    aspect-ratio: 1 / 2;
    display: block;
    border: 1px solid var(--border-strong);
    box-shadow: 0 18px 40px rgba(28, 28, 28, 0.14);
    background: var(--bg);
  }

  .visual-mobile img {
    object-position: 50% 0;
  }

  .visual-desktop img {
    object-position: 50% 0;
  }

  .project-alt-meta {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .project-alt-title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 0.9rem;
  }

  .project-alt .cat-list {
    margin-bottom: 1.25rem;
  }

  .project-alt-text {
    font-size: 0.875rem;
    line-height: 1.9;
    color: var(--text-soft);
    max-width: 56ch;
    margin-bottom: 1.25rem;
  }

  .point-list {
    list-style: none;
    margin-bottom: 1.75rem;
  }

  .point-list li {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-soft);
    padding-left: 1.1rem;
    position: relative;
    margin-bottom: 0.45rem;
  }

  .point-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 4px;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .feature-body,
    .project-alt {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }

    .feature-body {
      column-gap: 0;
    }
  }

  @media (max-width: 640px) {
    .section {
      padding-top: 4.5rem;
    }

    .feature-media {
      aspect-ratio: 3 / 2;
    }

    .project-alt {
      margin-top: 4rem;
    }
  }
</style>
