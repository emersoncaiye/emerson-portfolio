---
import Layout from '../../layouts/Layout.astro';
import Resume from '../../components/Resume.astro';
import { languages } from '../../i18n/translations';

const lang = 'yue';
const t = languages[lang];
const langLinks = [
  { code: 'en', label: 'EN', href: '/', active: false },
  { code: 'zh', label: '中文', href: '/zh/', active: false },
  { code: 'yue', label: '粵語', href: '/yue/', active: true },
  { code: 'fr', label: 'FR', href: '/fr/', active: false },
];
---

<Layout title={t.title}>
  <Resume lang={lang} t={t} langLinks={langLinks} />
</Layout>
